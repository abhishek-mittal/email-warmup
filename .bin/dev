#!/usr/bin/env bash
# Local development orchestrator for EmailWarm.
#
# Usage:
#   .bin/dev up        # start infra (postgres + redis) + backend + frontend
#                       #   and (on macOS) auto-open a live log TUI in a new
#                       #   Terminal window — uses `multitail` if installed
#                       #   (split columns, search, scroll), or `tail -F` of
#                       #   both log files in one window as a fallback.
#   .bin/dev start     # alias for `up`
#   .bin/dev stop      # stop backend + frontend (keeps infra running)
#   .bin/dev down      # stop everything including infra containers
#   .bin/dev restart   # stop backend + frontend, then start them again
#   .bin/dev status    # show what's running and where
#   .bin/dev logs [backend|frontend|infra]  # tail logs in the current terminal
#   .bin/dev watchdog  # foreground loop: auto-restart backend/frontend if
#                       #   either dies (e.g. uncaughtException from a
#                       #   third-party library like imapflow). Polls every 5s.
#
# Environment:
#   LOG_TUI=auto (default)  open a live log TUI in a new Terminal window
#   LOG_TUI=none            skip the auto-opened TUI; use `.bin/dev logs` instead
#
# PIDs and ports are tracked in .bin/.runtime/ so stop/restart/status are reliable.
# This script is intentionally self-contained — no Node deps, no global tools beyond
# docker / pnpm / lsof that you already need for local dev.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNTIME="$ROOT/.bin/.runtime"
mkdir -p "$RUNTIME"

PID_BACKEND="$RUNTIME/backend.pid"
PID_FRONTEND="$RUNTIME/frontend.pid"
LOG_BACKEND="$RUNTIME/backend.log"
LOG_FRONTEND="$RUNTIME/frontend.log"

PORT_BACKEND=4611
PORT_FRONTEND=3000

# ----- helpers ---------------------------------------------------------------

log() { printf '\033[1;34m[dev]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[dev]\033[0m %s\n' "$*" >&2; }
err() { printf '\033[1;31m[dev]\033[0m %s\n' "$*" >&2; }

is_running() {
  local pidfile="$1"
  [[ -f "$pidfile" ]] || return 1
  local pid
  pid="$(cat "$pidfile" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  return 1
}

port_listening() {
  local port="$1"
  if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

stop_pidfile() {
  local name="$1" pidfile="$2"
  local port="${3:-}"
  # Pattern to find ALL processes related to this service. We match by
  # the long-running process names rather than the tracked parent PID
  # because `pnpm run start:dev` and `next dev` both spawn child workers
  # (`nest start --watch`, `next-server`) that get reparented to launchd
  # if the parent dies. Killing only the PID in the file leaves the
  # children alive — they don't own the port (the parent does that on
  # their behalf), so the next `up` would see a free port, spawn a new
  # parent, and end up with TWO competing process trees. We use pkill
  # to clear the whole family by name as the primary cleanup.
  local pattern=""
  case "$name" in
    backend)  pattern="pnpm run start:dev|nest start --watch" ;;
    frontend) pattern="pnpm run dev|next dev|next-server" ;;
  esac
  if is_running "$pidfile"; then
    local pid
    pid="$(cat "$pidfile")"
    log "stopping $name (pid $pid)..."
    # Try SIGTERM first so nest --watch / next dev can flush; escalate after 5s.
    kill "$pid" 2>/dev/null || true
    for _ in {1..25}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.2
    done
    if kill -0 "$pid" 2>/dev/null; then
      warn "$name did not exit on SIGTERM; sending SIGKILL"
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$pidfile"
  else
    rm -f "$pidfile"
    log "$name already stopped"
  fi

  # Sweep any survivors by name — covers orphaned next-server workers
  # and nest --watch children whose parent died first. pkill -x matches
  # the exact process name; -f matches against the full command line.
  # We use the latter so we catch `node /path/to/.../nest start --watch`
  # (a single node process whose basename is `node`, but whose args
  # include the dev command).
  if [[ -n "$pattern" ]]; then
    # shellcheck disable=SC2086
    pkill -f "$pattern" 2>/dev/null || true
    sleep 0.5
    # Anything still bound to the port gets SIGKILL — last-resort cleanup.
    if [[ -n "$port" ]] && port_listening "$port"; then
      local orphans
      orphans="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null || true)"
      if [[ -n "$orphans" ]]; then
        warn "port $port still bound after name sweep — killing $(echo $orphans)"
        # shellcheck disable=SC2086
        kill -9 $orphans 2>/dev/null || true
        sleep 0.5
      fi
    fi
  fi

  if [[ -n "$port" ]] && port_listening "$port"; then
    err "port $port is still bound after stop_pidfile cleanup"
    return 1
  fi
}

# ----- subcommands -----------------------------------------------------------

cmd_up() {
  log "starting infra (postgres + redis)..."
  (cd "$ROOT" && docker compose up -d)

  # backend
  if is_running "$PID_BACKEND" && port_listening "$PORT_BACKEND"; then
    log "backend already running (pid $(cat "$PID_BACKEND"))"
  else
    # Stale PID file (parent died but the PID file was never cleaned up)
    # or orphan listening on the port — both cases need a port-broom
    # before we can bind a fresh nest process.
    if port_listening "$PORT_BACKEND"; then
      warn "port $PORT_BACKEND is bound but our PID file is stale — sweeping"
      local orphans
      orphans="$(lsof -nP -iTCP:"$PORT_BACKEND" -sTCP:LISTEN -t 2>/dev/null || true)"
      [[ -n "$orphans" ]] && kill -9 $orphans 2>/dev/null || true
      sleep 0.5
    fi
    rm -f "$PID_BACKEND"
    log "starting backend on :$PORT_BACKEND..."
    # Spawn the dev process with stdio fully detached. We use a plain
    # background `&` (not a subshell `( ... & )`) so the parent shell
    # owns the job and `disown` cleanly removes it from the job table
    # — once disowned, the spawned dev is reparented to launchd and
    # never receives SIGHUP when the parent shell exits.
    cd "$ROOT/backend"
    nohup pnpm run start:dev </dev/null >"$LOG_BACKEND" 2>&1 &
    echo $! >"$PID_BACKEND"
    disown 2>/dev/null || true
    cd "$ROOT"
    for _ in {1..40}; do
      if port_listening "$PORT_BACKEND"; then break; fi
      sleep 0.25
    done
    if port_listening "$PORT_BACKEND"; then
      log "backend up → http://localhost:$PORT_BACKEND (pid $(cat "$PID_BACKEND"))"
    else
      err "backend failed to bind :$PORT_BACKEND within 10s. Check $LOG_BACKEND"
      return 1
    fi
  fi

  # frontend
  if is_running "$PID_FRONTEND" && port_listening "$PORT_FRONTEND"; then
    log "frontend already running (pid $(cat "$PID_FRONTEND"))"
  else
    # Same orphan guard as backend. Without this, a surviving next-server
    # worker from a previous run binds port 3000 silently, our new
    # `next dev` falls back to 3002, and Turbopack then panics with
    # "Another next dev server is already running" because the
    # .next/dev/lock file is shared.
    if port_listening "$PORT_FRONTEND"; then
      warn "port $PORT_FRONTEND is bound but our PID file is stale — sweeping"
      local orphans
      orphans="$(lsof -nP -iTCP:"$PORT_FRONTEND" -sTCP:LISTEN -t 2>/dev/null || true)"
      [[ -n "$orphans" ]] && kill -9 $orphans 2>/dev/null || true
      # Also clear Turbopack's dev lock — without this, a new `next dev`
      # refuses to start with "Another next dev server is already running"
      # even if the actual processes are gone.
      rm -f "$ROOT/frontend/.next/dev/lock" 2>/dev/null || true
      sleep 0.5
    fi
    rm -f "$PID_FRONTEND"
    log "starting frontend on :$PORT_FRONTEND..."
    # See backend note above.
    cd "$ROOT/frontend"
    nohup pnpm run dev </dev/null >"$LOG_FRONTEND" 2>&1 &
    echo $! >"$PID_FRONTEND"
    disown 2>/dev/null || true
    cd "$ROOT"
    for _ in {1..60}; do
      if port_listening "$PORT_FRONTEND"; then break; fi
      sleep 0.25
    done
    if port_listening "$PORT_FRONTEND"; then
      log "frontend up → http://localhost:$PORT_FRONTEND (pid $(cat "$PID_FRONTEND"))"
    else
      err "frontend failed to bind :$PORT_FRONTEND within 15s. Check $LOG_FRONTEND"
      return 1
    fi
  fi

  # Auto-start the watchdog in its own Terminal tab so a single
  # `unhandledRejection` from a third-party library (the imapflow
  # ECONNRESET case from 2026-06-24) doesn't silently take the whole
  # backend down. The watchdog opens a new tab on macOS via osascript;
  # if that fails (CI, no Terminal.app, etc.) it prints a hint to run
  # `.bin/dev watchdog` manually. Set DEV_NO_WATCHDOG=1 to opt out.
  if [[ "${DEV_NO_WATCHDOG:-0}" != "1" ]]; then
    cmd_open_watchdog
  fi

  cmd_status
  cmd_open_log_tui
}

cmd_open_log_tui() {
  # If the user disabled the auto-launch (CI, single-shot CLI, or they
  # just want plain tail -f), bail. Set LOG_TUI=none to opt out.
  if [[ "${LOG_TUI:-auto}" == "none" ]]; then
    return 0
  fi

  # If neither process actually came up, don't open a window showing
  # nothing — cmd_up already printed the failure.
  if ! is_running "$PID_BACKEND" && ! is_running "$PID_FRONTEND"; then
    return 0
  fi

  # Prefer multitail (split columns, search, scroll). Fall back to
  # `tail -f` of both logs in a single new Terminal tab if multitail
  # isn't installed — keeps the script useful on a fresh machine
  # without forcing a brew dependency.
  local command_str
  if command -v multitail >/dev/null 2>&1; then
    # -j: just-in-time column resizing on terminal resize
    # -s 2: split into 2 columns
    # Each -l runs the given command in its own column.
    # `--label` gives each column a colored header strip.
    command_str="multitail -j -s 2 \
      -l 'tail -n 80 -F $LOG_BACKEND'  --label 'backend (4611)' \
      -l 'tail -n 80 -F $LOG_FRONTEND' --label 'frontend (3000)'"
  else
    # tail -F (capital) follows the file by name, so a `.bin/dev restart`
    # that truncates and reopens the log doesn't break the follow.
    command_str="tail -n 80 -F $LOG_BACKEND $LOG_FRONTEND"
  fi

  # Open in a new Terminal.app window (macOS-only — this script already
  # assumes macOS via `lsof -nP -iTCP` and `nohup` style usage).
  if ! command -v osascript >/dev/null 2>&1; then
    warn "osascript not found; can't auto-open the log TUI. Run '.bin/dev logs' in your own terminal."
    return 0
  fi

  log "opening live log TUI in a new Terminal window (LOG_TUI=none to skip)"
  osascript <<EOF >/dev/null 2>&1 &
tell application "Terminal"
  activate
  do script "clear; printf '\\\\033[1;34m[dev]\\\\033[0m EmailWarm live logs — close this window to stop.\\\\n'; $command_str"
end tell
EOF
}

# Open the watchdog loop in its own Terminal tab. Runs `.bin/dev watchdog`
# as a foreground process in a new tab — when the user closes the tab
# the watchdog stops. Mirrors cmd_open_log_tui's approach so both
# "ambient" dev processes get the same Terminal-app treatment.
cmd_open_watchdog() {
  if ! command -v osascript >/dev/null 2>&1; then
    warn "osascript not found; run '.bin/dev watchdog' manually to enable auto-restart"
    return 0
  fi
  osascript <<EOF >/dev/null 2>&1 &
tell application "Terminal"
  activate
  do script "clear; printf '\\\\033[1;34m[dev]\\\\033[0m EmailWarm watchdog — auto-restarts backend/frontend on crash.\\\\n\\\\033[1;33mClose this tab to stop the watchdog.\\\\n\\\\n'; cd '$ROOT' && '$ROOT/.bin/dev' watchdog"
end tell
EOF
}

cmd_stop() {
  stop_pidfile "frontend" "$PID_FRONTEND" "$PORT_FRONTEND"
  stop_pidfile "backend"  "$PID_BACKEND"  "$PORT_BACKEND"
  log "infra (postgres + redis) left running. Use `.bin/dev down` to stop those too."
}

cmd_down() {
  stop_pidfile "frontend" "$PID_FRONTEND" "$PORT_FRONTEND"
  stop_pidfile "backend"  "$PID_BACKEND"  "$PORT_BACKEND"
  log "stopping infra containers..."
  (cd "$ROOT" && docker compose down)
  log "all stopped."
}

cmd_restart() {
  cmd_stop
  # Give the OS a moment to release the port (TIME_WAIT for the prior
  # socket) and pkill's signal to propagate to all survivors. 2s is
  # generous; if a binding still races we surface it in cmd_up's
  # "port bound but PID file stale — sweeping" branch.
  sleep 2
  cmd_up
}

cmd_status() {
  printf '\n%-10s %-8s %-22s %s\n' "service" "state" "pid" "detail"
  printf '%-10s %-8s %-22s %s\n' "-------" "-----" "---" "------"

  if is_running "$PID_BACKEND"; then
    local bpid; bpid="$(cat "$PID_BACKEND")"
    local bstate="up"
    if port_listening "$PORT_BACKEND"; then bstate="listening"; fi
    printf '%-10s %-8s %-22s %s\n' "backend" "$bstate" "$bpid" "http://localhost:$PORT_BACKEND"
  else
    printf '%-10s %-8s %-22s %s\n' "backend" "stopped" "-" "log: $LOG_BACKEND"
  fi

  if is_running "$PID_FRONTEND"; then
    local fpid; fpid="$(cat "$PID_FRONTEND")"
    local fstate="up"
    if port_listening "$PORT_FRONTEND"; then fstate="listening"; fi
    printf '%-10s %-8s %-22s %s\n' "frontend" "$fstate" "$fpid" "http://localhost:$PORT_FRONTEND"
  else
    printf '%-10s %-8s %-22s %s\n' "frontend" "stopped" "-" "log: $LOG_FRONTEND"
  fi

  printf '%-10s ' "infra"
  if (cd "$ROOT" && docker compose ps --services --status running 2>/dev/null | grep -q .); then
    printf '%-8s %-22s %s\n' "running" "-" "(docker compose ps)"
  else
    printf '%-8s %-22s %s\n' "stopped" "-" "(docker compose up -d)"
  fi
  echo
}

cmd_logs() {
  local target="${1:-}"
  case "$target" in
    backend)  tail -n 80 -f "$LOG_BACKEND" ;;
    frontend) tail -n 80 -f "$LOG_FRONTEND" ;;
    infra)
      (cd "$ROOT" && docker compose logs -f --tail=80)
      ;;
    "")
      warn "usage: .bin/dev logs {backend|frontend|infra}"
      return 1
      ;;
    *)
      err "unknown target: $target (expected backend|frontend|infra)"
      return 1
      ;;
  esac
}

# Foreground watchdog. Polls both PID files every 5s; if a tracked
# process is dead AND the port is unbound, restarts just that service
# (full stop_pidfile sweep first to clear any orphaned children). The
# 2026-06-24 ECONNRESET crash took the backend down silently — no
# process-level uncaughtException handler in Nest, no process supervisor
# to revive it. This watchdog is the process supervisor. It does NOT
# auto-attach the log TUI; run it in its own Terminal tab with
# `.bin/dev logs backend` open in another.
#
# Why polling instead of waitpid? `nohup ... &` with `disown` reparents
# the child to launchd, so we lose the parent-child relationship and
# can't trap SIGCHLD. The PID file is the source of truth.
cmd_watchdog() {
  log "watchdog started — polling :$PORT_BACKEND and :$PORT_FRONTEND every 5s"
  log "  Ctrl-C to stop. Use '.bin/dev stop' to terminate services."
  while true; do
    # Backend check.
    if [[ -f "$PID_BACKEND" ]] && ! is_running "$PID_BACKEND"; then
      warn "backend pid $(cat "$PID_BACKEND") is dead — restarting"
      # Best-effort cleanup of any orphan workers before respawning.
      pkill -f "nest start --watch" 2>/dev/null || true
      sleep 1
      if port_listening "$PORT_BACKEND"; then
        local orphans
        orphans="$(lsof -nP -iTCP:"$PORT_BACKEND" -sTCP:LISTEN -t 2>/dev/null || true)"
        [[ -n "$orphans" ]] && kill -9 $orphans 2>/dev/null || true
        sleep 1
      fi
      rm -f "$PID_BACKEND"
      cd "$ROOT/backend"
      nohup pnpm run start:dev </dev/null >>"$LOG_BACKEND" 2>&1 &
      echo $! >"$PID_BACKEND"
      disown 2>/dev/null || true
      cd "$ROOT"
      log "backend respawned as pid $(cat "$PID_BACKEND")"
    fi

    # Frontend check (same logic).
    if [[ -f "$PID_FRONTEND" ]] && ! is_running "$PID_FRONTEND"; then
      warn "frontend pid $(cat "$PID_FRONTEND") is dead — restarting"
      pkill -f "next dev|next-server" 2>/dev/null || true
      sleep 1
      if port_listening "$PORT_FRONTEND"; then
        local orphans
        orphans="$(lsof -nP -iTCP:"$PORT_FRONTEND" -sTCP:LISTEN -t 2>/dev/null || true)"
        [[ -n "$orphans" ]] && kill -9 $orphans 2>/dev/null || true
        rm -f "$ROOT/frontend/.next/dev/lock" 2>/dev/null || true
        sleep 1
      fi
      rm -f "$PID_FRONTEND"
      cd "$ROOT/frontend"
      nohup pnpm run dev </dev/null >>"$LOG_FRONTEND" 2>&1 &
      echo $! >"$PID_FRONTEND"
      disown 2>/dev/null || true
      cd "$ROOT"
      log "frontend respawned as pid $(cat "$PID_FRONTEND")"
    fi

    sleep 5
  done
}

# ----- dispatch --------------------------------------------------------------

usage() {
  sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  up|start)     shift; cmd_up "$@" ;;
  stop)         shift; cmd_stop "$@" ;;
  down)         shift; cmd_down "$@" ;;
  restart)      shift; cmd_restart "$@" ;;
  status|st)    shift; cmd_status "$@" ;;
  logs|log)     shift; cmd_logs "$@" ;;
  watchdog|wd)  shift; cmd_watchdog "$@" ;;
  -h|--help|help|"") usage ;;
  *) err "unknown command: $1"; usage; exit 1 ;;
esac