#!/usr/bin/env bash
# Local development orchestrator for EmailWarm.
#
# Usage:
#   .bin/dev up        # start infra (postgres + redis) + backend + frontend
#                       #   and (on macOS) auto-open a live log TUI in a new
#                       #   Terminal window — uses `multitail` if installed
#                       #   (split columns, search, scroll), or `tail -F` of
#                       #   both log files in one window as a fallback.
#   .bin/dev start     # alias for `up`
#   .bin/dev stop      # stop backend + frontend (keeps infra running)
#   .bin/dev down      # stop everything including infra containers
#   .bin/dev restart   # stop backend + frontend, then start them again
#   .bin/dev status    # show what's running and where
#   .bin/dev logs [backend|frontend|infra]  # tail logs in the current terminal
#
# Environment:
#   LOG_TUI=auto (default)  open a live log TUI in a new Terminal window
#   LOG_TUI=none            skip the auto-opened TUI; use `.bin/dev logs` instead
#
# PIDs and ports are tracked in .bin/.runtime/ so stop/restart/status are reliable.
# This script is intentionally self-contained — no Node deps, no global tools beyond
# docker / pnpm / lsof that you already need for local dev.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNTIME="$ROOT/.bin/.runtime"
mkdir -p "$RUNTIME"

PID_BACKEND="$RUNTIME/backend.pid"
PID_FRONTEND="$RUNTIME/frontend.pid"
LOG_BACKEND="$RUNTIME/backend.log"
LOG_FRONTEND="$RUNTIME/frontend.log"

PORT_BACKEND=3001
PORT_FRONTEND=3000

# ----- helpers ---------------------------------------------------------------

log() { printf '\033[1;34m[dev]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[dev]\033[0m %s\n' "$*" >&2; }
err() { printf '\033[1;31m[dev]\033[0m %s\n' "$*" >&2; }

is_running() {
  local pidfile="$1"
  [[ -f "$pidfile" ]] || return 1
  local pid
  pid="$(cat "$pidfile" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  return 1
}

port_listening() {
  local port="$1"
  if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

stop_pidfile() {
  local name="$1" pidfile="$2"
  if is_running "$pidfile"; then
    local pid
    pid="$(cat "$pidfile")"
    log "stopping $name (pid $pid)..."
    # Try SIGTERM first so nest --watch / next dev can flush; escalate after 5s.
    kill "$pid" 2>/dev/null || true
    for _ in {1..25}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.2
    done
    if kill -0 "$pid" 2>/dev/null; then
      warn "$name did not exit on SIGTERM; sending SIGKILL"
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$pidfile"
  else
    rm -f "$pidfile"
    log "$name already stopped"
  fi
}

# ----- subcommands -----------------------------------------------------------

cmd_up() {
  log "starting infra (postgres + redis)..."
  (cd "$ROOT" && docker compose up -d)

  # backend
  if is_running "$PID_BACKEND"; then
    log "backend already running (pid $(cat "$PID_BACKEND"))"
  else
    log "starting backend on :$PORT_BACKEND..."
    ( cd "$ROOT/backend" && nohup pnpm run start:dev >"$LOG_BACKEND" 2>&1 & echo $! >"$PID_BACKEND" )
    for _ in {1..40}; do
      if port_listening "$PORT_BACKEND"; then break; fi
      sleep 0.25
    done
    if port_listening "$PORT_BACKEND"; then
      log "backend up → http://localhost:$PORT_BACKEND (pid $(cat "$PID_BACKEND"))"
    else
      err "backend failed to bind :$PORT_BACKEND within 10s. Check $LOG_BACKEND"
      return 1
    fi
  fi

  # frontend
  if is_running "$PID_FRONTEND"; then
    log "frontend already running (pid $(cat "$PID_FRONTEND"))"
  else
    log "starting frontend on :$PORT_FRONTEND..."
    ( cd "$ROOT/frontend" && nohup pnpm run dev >"$LOG_FRONTEND" 2>&1 & echo $! >"$PID_FRONTEND" )
    for _ in {1..60}; do
      if port_listening "$PORT_FRONTEND"; then break; fi
      sleep 0.25
    done
    if port_listening "$PORT_FRONTEND"; then
      log "frontend up → http://localhost:$PORT_FRONTEND (pid $(cat "$PID_FRONTEND"))"
    else
      err "frontend failed to bind :$PORT_FRONTEND within 15s. Check $LOG_FRONTEND"
      return 1
    fi
  fi

  cmd_status
  cmd_open_log_tui
}

cmd_open_log_tui() {
  # If the user disabled the auto-launch (CI, single-shot CLI, or they
  # just want plain tail -f), bail. Set LOG_TUI=none to opt out.
  if [[ "${LOG_TUI:-auto}" == "none" ]]; then
    return 0
  fi

  # If neither process actually came up, don't open a window showing
  # nothing — cmd_up already printed the failure.
  if ! is_running "$PID_BACKEND" && ! is_running "$PID_FRONTEND"; then
    return 0
  fi

  # Prefer multitail (split columns, search, scroll). Fall back to
  # `tail -f` of both logs in a single new Terminal tab if multitail
  # isn't installed — keeps the script useful on a fresh machine
  # without forcing a brew dependency.
  local command_str
  if command -v multitail >/dev/null 2>&1; then
    # -j: just-in-time column resizing on terminal resize
    # -s 2: split into 2 columns
    # Each -l runs the given command in its own column.
    # `--label` gives each column a colored header strip.
    command_str="multitail -j -s 2 \
      -l 'tail -n 80 -F $LOG_BACKEND'  --label 'backend (3001)' \
      -l 'tail -n 80 -F $LOG_FRONTEND' --label 'frontend (3000)'"
  else
    # tail -F (capital) follows the file by name, so a `.bin/dev restart`
    # that truncates and reopens the log doesn't break the follow.
    command_str="tail -n 80 -F $LOG_BACKEND $LOG_FRONTEND"
  fi

  # Open in a new Terminal.app window (macOS-only — this script already
  # assumes macOS via `lsof -nP -iTCP` and `nohup` style usage).
  if ! command -v osascript >/dev/null 2>&1; then
    warn "osascript not found; can't auto-open the log TUI. Run '.bin/dev logs' in your own terminal."
    return 0
  fi

  log "opening live log TUI in a new Terminal window (LOG_TUI=none to skip)"
  osascript <<EOF >/dev/null 2>&1 &
tell application "Terminal"
  activate
  do script "clear; printf '\\\\033[1;34m[dev]\\\\033[0m EmailWarm live logs — close this window to stop.\\\\n'; $command_str"
end tell
EOF
}

cmd_stop() {
  stop_pidfile "frontend" "$PID_FRONTEND"
  stop_pidfile "backend"  "$PID_BACKEND"
  log "infra (postgres + redis) left running. Use `.bin/dev down` to stop those too."
}

cmd_down() {
  stop_pidfile "frontend" "$PID_FRONTEND"
  stop_pidfile "backend"  "$PID_BACKEND"
  log "stopping infra containers..."
  (cd "$ROOT" && docker compose down)
  log "all stopped."
}

cmd_restart() {
  cmd_stop
  sleep 1
  cmd_up
}

cmd_status() {
  printf '\n%-10s %-8s %-22s %s\n' "service" "state" "pid" "detail"
  printf '%-10s %-8s %-22s %s\n' "-------" "-----" "---" "------"

  if is_running "$PID_BACKEND"; then
    local bpid; bpid="$(cat "$PID_BACKEND")"
    local bstate="up"
    if port_listening "$PORT_BACKEND"; then bstate="listening"; fi
    printf '%-10s %-8s %-22s %s\n' "backend" "$bstate" "$bpid" "http://localhost:$PORT_BACKEND"
  else
    printf '%-10s %-8s %-22s %s\n' "backend" "stopped" "-" "log: $LOG_BACKEND"
  fi

  if is_running "$PID_FRONTEND"; then
    local fpid; fpid="$(cat "$PID_FRONTEND")"
    local fstate="up"
    if port_listening "$PORT_FRONTEND"; then fstate="listening"; fi
    printf '%-10s %-8s %-22s %s\n' "frontend" "$fstate" "$fpid" "http://localhost:$PORT_FRONTEND"
  else
    printf '%-10s %-8s %-22s %s\n' "frontend" "stopped" "-" "log: $LOG_FRONTEND"
  fi

  printf '%-10s ' "infra"
  if (cd "$ROOT" && docker compose ps --services --status running 2>/dev/null | grep -q .); then
    printf '%-8s %-22s %s\n' "running" "-" "(docker compose ps)"
  else
    printf '%-8s %-22s %s\n' "stopped" "-" "(docker compose up -d)"
  fi
  echo
}

cmd_logs() {
  local target="${1:-}"
  case "$target" in
    backend)  tail -n 80 -f "$LOG_BACKEND" ;;
    frontend) tail -n 80 -f "$LOG_FRONTEND" ;;
    infra)
      (cd "$ROOT" && docker compose logs -f --tail=80)
      ;;
    "")
      warn "usage: .bin/dev logs {backend|frontend|infra}"
      return 1
      ;;
    *)
      err "unknown target: $target (expected backend|frontend|infra)"
      return 1
      ;;
  esac
}

# ----- dispatch --------------------------------------------------------------

usage() {
  sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  up|start)     shift; cmd_up "$@" ;;
  stop)         shift; cmd_stop "$@" ;;
  down)         shift; cmd_down "$@" ;;
  restart)      shift; cmd_restart "$@" ;;
  status|st)    shift; cmd_status "$@" ;;
  logs|log)     shift; cmd_logs "$@" ;;
  -h|--help|help|"") usage ;;
  *) err "unknown command: $1"; usage; exit 1 ;;
esac