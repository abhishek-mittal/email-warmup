# EmailWarm — GitHub `staging` Environment sync source (TEMPLATE).
#
# Copy this to deploy/.env.staging (gitignored), fill in real values, then run:
#   bash deploy/sync-staging-env.sh --dry-run    # preview
#   bash deploy/sync-staging-env.sh              # apply
#
# The sync script pushes each key below to the repo's `staging` Environment as
# either a SECRET or a VARIABLE (classification is fixed in the script and
# matches how .github/workflows/deploy-staging.yml reads them: secrets.X vs
# vars.X). Keys left empty are SKIPPED with a warning.
#
# This file lists ONLY the keys GitHub manages. The rest of the runtime env
# (DATABASE_URL, REDIS_URL, APP_URL, API_URL, BETTER_AUTH_URL, ZITADEL_ISSUER,
# DEMO_MODE, LOG_LEVEL, CORS_ORIGINS, PORT) is written literally by the deploy
# workflow when it renders /etc/emailwarm/staging.env — do not put them here.

# =========================== SECRETS ===========================

# --- Infra ---

# Postgres password for the in-container DB. You CHOOSE this (the postgres
# container is created with it on first deploy); the backend DATABASE_URL is
# built from it. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# Public IPv4 of the ishosting VPS (same box as the dmphub probe host).
# Find it: ishosting panel, or `curl -4 ifconfig.me` run on the box.
EMAILWARM_HOST_IP=

# GitHub Personal Access Token the VPS uses to `docker login ghcr.io` and pull
# images. github.com -> Settings -> Developer settings -> Personal access tokens
# -> Tokens (classic) -> Generate new token -> scope: read:packages. Paste here.
GHCR_PULL_TOKEN=

# Path to a CI-only SSH PRIVATE key (the multiline key is read from this file,
# not pasted here). Generate:
#   ssh-keygen -t ed25519 -f ~/.ssh/emailwarm_deploy -C emailwarm-ci -N ''
# Then add the PUBLIC key (~/.ssh/emailwarm_deploy.pub) to the VPS:
#   ssh root@<VPS_IP> 'cat >> ~/.ssh/authorized_keys' < ~/.ssh/emailwarm_deploy.pub
# Put the PRIVATE key's path below (the sync uploads its contents as a secret).
EMAILWARM_DEPLOY_KEY_FILE=

# --- App ---

# AES-256-GCM key that encrypts stored mailbox credentials. 32-byte hex.
# Generate: openssl rand -hex 32
# WARNING: never change this once inboxes exist — it would make stored
# credentials undecryptable.
ENCRYPTION_KEY=

# better-auth session signing secret. MUST be identical for frontend+backend
# (this one value is used by both). 32+ chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Shared secret for backend<->frontend internal calls (user-sync). 16+ chars.
# Generate: openssl rand -base64 24
INTERNAL_SECRET=

# Anthropic API key for AI diagnostics (claude-haiku). Get it at:
# console.anthropic.com -> API keys -> Create key. Starts with sk-ant-.
ANTHROPIC_API_KEY=

# Google OAuth client SECRET (pairs with GOOGLE_CLIENT_ID below).
# Google Cloud Console -> APIs & Services -> Credentials -> your OAuth 2.0
# Client ID -> client secret. On that client, add the authorized redirect URI:
#   https://stg-ew.webnco.xyz/api/mailbox-oauth/callback/google
GOOGLE_CLIENT_SECRET=

# Microsoft/Azure OAuth client SECRET (pairs with MICROSOFT_CLIENT_ID).
# Azure Portal -> App registrations -> your app -> Certificates & secrets ->
# New client secret (copy the VALUE, not the Secret ID). Redirect URI to add:
#   https://stg-ew.webnco.xyz/api/mailbox-oauth/callback/microsoft
MICROSOFT_CLIENT_SECRET=

# Password (or app password) for the PLATFORM mailer account — the inbox that
# sends product/system email from PLATFORM_FROM_EMAIL. For Gmail, create an
# app password (not the account password).
PLATFORM_SMTP_PASS=

# Citadel (Zitadel at id.webnco.xyz) OAuth client SECRET for the stg-ew app.
# id.webnco.xyz -> your project -> the EmailWarm staging application -> Client
# secret (regenerate if unknown). Pairs with ZITADEL_CLIENT_ID below.
ZITADEL_CLIENT_SECRET=

# ========================== VARIABLES ==========================

# Google OAuth client ID (same client as GOOGLE_CLIENT_SECRET). Looks like
# 1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Azure application (client) ID (same app as MICROSOFT_CLIENT_SECRET). A GUID.
MICROSOFT_CLIENT_ID=

# Platform mailer SMTP host/port/user (the account that sends system email).
# Example for Gmail: smtp.gmail.com / 587 / your-sender@yourdomain.
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=

# From header on platform email. Keep the "Name <addr>" form.
PLATFORM_FROM_EMAIL=EmailWarm <noreply@emailwarm.io>

# Demo-plan credits granted to new accounts (billing is deferred/DEMO_MODE).
# Defaults are fine for staging.
DEMO_INBOX_CREDITS=10
DEMO_PLACEMENT_CREDITS=5

# Citadel application client ID for the stg-ew app (pairs with the secret above).
ZITADEL_CLIENT_ID=

# Comma-separated emails granted founder/admin access in the app (e.g. yours).
FOUNDER_EMAILS=

# Baked into the frontend bundle at BUILD time (browser calls this origin).
# For staging both are the public app URL. Leave as-is unless the domain changes.
NEXT_PUBLIC_API_URL=https://stg-ew.webnco.xyz
NEXT_PUBLIC_BETTER_AUTH_URL=https://stg-ew.webnco.xyz
