# EmailWarm staging environment — authoritative key list.
# Real values live in the GitHub `staging` Environment and are rendered
# by the deploy workflow into /etc/emailwarm/staging.env on the box.
# NEVER commit real secrets. Service hostnames (postgres/redis/backend)
# are the compose network DNS names — do not change them.
#
# NOTE: PORT is intentionally NOT here. The compose file pins each
# service's port (backend 4611, frontend 3100); a shared PORT key would
# make both bind the same port.
#
# [REQUIRED] = the backend's env validation rejects an empty value and the
# container crash-loops. Every [REQUIRED] key must be set non-empty in the
# GitHub `staging` Environment.

# --- infra / compose ---
POSTGRES_PASSWORD=                 # [REQUIRED] secret; also used to build DATABASE_URL
IMAGE_TAG=staging                  # set by CI to the commit SHA

# --- backend ---
DATABASE_URL=postgresql://emailwarm:${POSTGRES_PASSWORD}@postgres:5432/emailwarm  # [REQUIRED]
REDIS_URL=redis://redis:6379/1                                                    # [REQUIRED]
ENCRYPTION_KEY=                    # [REQUIRED] secret; 32-byte hex
BETTER_AUTH_SECRET=               # [REQUIRED] secret; 32+ chars (shared with frontend)
INTERNAL_SECRET=                  # [REQUIRED] secret; 16+ chars (shared with frontend)
ANTHROPIC_API_KEY=               # [REQUIRED] secret
GOOGLE_CLIENT_ID=                 # [REQUIRED]
GOOGLE_CLIENT_SECRET=            # [REQUIRED] secret
MICROSOFT_CLIENT_ID=              # [REQUIRED]
MICROSOFT_CLIENT_SECRET=         # [REQUIRED] secret
PLATFORM_SMTP_HOST=              # [REQUIRED]
PLATFORM_SMTP_PORT=587           # [REQUIRED]
PLATFORM_SMTP_USER=             # [REQUIRED]
PLATFORM_SMTP_PASS=             # [REQUIRED] secret
PLATFORM_FROM_EMAIL=EmailWarm <noreply@emailwarm.io>  # [REQUIRED]
APP_URL=https://stg-ew.webnco.xyz
CORS_ORIGINS=https://stg-ew.webnco.xyz
LOG_LEVEL=info
DEMO_MODE=true
DEMO_INBOX_CREDITS=10
DEMO_PLACEMENT_CREDITS=5

# --- frontend ---
API_URL=http://backend:4611
NEXT_PUBLIC_API_URL=https://stg-ew.webnco.xyz
BETTER_AUTH_URL=https://stg-ew.webnco.xyz
NEXT_PUBLIC_BETTER_AUTH_URL=https://stg-ew.webnco.xyz
ZITADEL_ISSUER=https://id.webnco.xyz
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=           # secret
FOUNDER_EMAILS=

# --- optional overrides (sensible defaults; set only to override) ---
# Mailbox OAuth callbacks default to ${APP_URL}/api/mailbox-oauth/callback/<provider>,
# which is correct for staging. Set these only if the registered redirect differs.
# GOOGLE_MAILBOX_REDIRECT_URI=https://stg-ew.webnco.xyz/api/mailbox-oauth/callback/google
# MICROSOFT_MAILBOX_REDIRECT_URI=https://stg-ew.webnco.xyz/api/mailbox-oauth/callback/microsoft
# AI diagnostics rate limit (per minute); defaults in code if unset.
# ANTHROPIC_DIAGNOSTIC_MAX_CALLS_PER_MIN=
