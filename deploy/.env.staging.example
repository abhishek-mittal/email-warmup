# EmailWarm — GitHub `staging` Environment sync source (TEMPLATE).
#
# Copy this to deploy/.env.staging (gitignored), fill in real values, then run:
#   bash deploy/sync-staging-env.sh --dry-run    # preview
#   bash deploy/sync-staging-env.sh              # apply
#
# The sync script pushes each key below to the repo's `staging` Environment as
# either a SECRET or a VARIABLE (classification is fixed in the script and
# matches how .github/workflows/deploy-staging.yml reads them: secrets.X vs
# vars.X). Keys left empty are SKIPPED with a warning.
#
# This file lists ONLY the keys GitHub manages. The rest of the runtime env
# (DATABASE_URL, REDIS_URL, APP_URL, API_URL, BETTER_AUTH_URL, ZITADEL_ISSUER,
# DEMO_MODE, LOG_LEVEL, CORS_ORIGINS, PORT) is written literally by the deploy
# workflow when it renders /etc/emailwarm/staging.env — do not put them here.

# =========================== SECRETS ===========================
# Infra
POSTGRES_PASSWORD=                 # also builds the backend DATABASE_URL
EMAILWARM_HOST_IP=                 # public IPv4 of the ishosting VPS
GHCR_PULL_TOKEN=                   # GitHub PAT with read:packages (box docker login)
# Multiline SSH private key — point at a file, the script reads its contents:
EMAILWARM_DEPLOY_KEY_FILE=         # e.g. ~/.ssh/emailwarm_deploy  (CI-only key)

# App
ENCRYPTION_KEY=                    # 32-byte hex
BETTER_AUTH_SECRET=               # 32+ chars (shared frontend/backend)
INTERNAL_SECRET=                  # 16+ chars (shared frontend/backend)
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_SECRET=
PLATFORM_SMTP_PASS=
ZITADEL_CLIENT_SECRET=

# ========================== VARIABLES ==========================
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=
PLATFORM_FROM_EMAIL=EmailWarm <noreply@emailwarm.io>
DEMO_INBOX_CREDITS=10
DEMO_PLACEMENT_CREDITS=5
ZITADEL_CLIENT_ID=
FOUNDER_EMAILS=
NEXT_PUBLIC_API_URL=https://stg-ew.webnco.xyz
NEXT_PUBLIC_BETTER_AUTH_URL=https://stg-ew.webnco.xyz
